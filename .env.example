# =====================================================================
# DeployGuard - Example environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file containing actual credentials.
# =====================================================================

# ---- PostgreSQL database ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=deployguard
DB_USER=deployguard_user
DB_PASSWORD=change_me_locally

# ---- Backend (Spring Boot) ----
# Origin(s) allowed to call the backend API (comma-separated for multiple).
FRONTEND_URL=http://localhost:5173
# Port the backend listens on inside its container / locally.
BACKEND_PORT=8080

# ---- Frontend (Vite/React) ----
# Base URL the frontend uses to reach the backend API.
VITE_API_URL=http://localhost:8080
